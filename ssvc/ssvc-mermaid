//Texte ci dessous à copier coller dans drawo.io via + Mermaid - exclure cette ligne
// Point ci dessous à verifier
graph LR
    %% Noeuds principaux
    Start((VULNÉRABILITÉ)) --> CVSS{Base_CVSS}

    %% CVSS < 7
    CVSS -- "<7" --> Track_Final[TRACK]

    %% CVSS >= 7
    CVSS -- ">=7" --> Expl{Exploitation}

    %% EXPLOITATION ACTIVE
    Expl -- "active" --> VSA{vehicle_sa-concerned}
    VSA -- "no" --> Dismiss_Final[Dismiss]
    VSA -- "yes" --> Asset{Asset_criticity}

    Asset -- "Standard&unknown" --> ExpStd{System_exposure}
    ExpStd -- "none" --> Dismiss_Final
    ExpStd -- "controlled" --> Track_Final
    ExpStd -- "open" --> Track_Final

    Asset -- "Strategic&critical" --> ExpStr{System_exposure}
    ExpStr -- "none" --> Defer_Final[Defer]
    
    ExpStr -- "controlled" --> SafCtrl{Safety_impact}
    SafCtrl -- "Catastrophic" --> SuppCtrl{Supplier_involvement}
    SafCtrl -- "critical" --> SuppCtrl
    SuppCtrl -- "unresponsive" --> Cyber_Final[CyberAnalysis_required]
    SuppCtrl -- "cooperative" --> Cyber_Final
    SuppCtrl -- "fix_ready" --> Sched_Final[Patch_shedule]

    ExpStr -- "open" --> SafOpen{Safety_impact}
    SafOpen -- "Catastrophic" --> Imm_Final[Patch_immediate]
    SafOpen -- "critical" --> Tech{Technical_impact}
    Tech -- "total" --> Imm_Final
    Tech -- "partial" --> SuppPart{Supplier_involvement}
    SuppPart -- "fix_ready" --> OOC_Final[Patch_out-of-cycle]
    SuppPart -- "cooperative" --> Sched_Final
    SuppPart -- "unresponsive" --> Cyber_Final
    SafOpen -- "marginal" --> SuppMarg{Supplier_involvement}
    SuppMarg -- "unresponsive" --> Cyber_Final
    SuppMarg -- "cooperative" --> Cyber_Final
    SuppMarg -- "fix_ready" --> Sched_Final

    %% EXPLOITATION POC
    Expl -- "poc" --> VSA2{vehicle_sa-concerned}
    VSA2 -- "no" --> Dismiss_Final
    VSA2 -- "yes" --> Asset2{Asset_criticity}
    Asset2 -- "Strategic&critical" --> SafPoc{Safety_impact}
    SafPoc -- "Catastrophic" --> SuppPoc{Supplier_involvement}
    SuppPoc -- "unresponsive" --> Cyber_Final
    SuppPoc -- "cooperative" --> Cyber_Final
    SuppPoc -- "fix_ready" --> Sched_Final
    SafPoc -- "critical" --> Track_Final
    SafPoc -- "marginal" --> Track_Final
    SafPoc -- "none" --> Track_Final

    %% EXPLOITATION NONE
    Expl -- "none" --> VSA3{vehicle_sa-concerned}
    VSA3 -- "no" --> Dismiss_Final
    VSA3 -- "yes" --> Asset3{Asset_criticity}
    Asset3 -- "Strategic&critical" --> ExpNone{System_exposure}
    ExpNone -- "none" --> Track_Final
    ExpNone -- "controlled" --> Track_Final
    ExpNone -- "open" --> SafNone{Safety_impact}
    SafNone -- "Catastrophic" --> SuppNone{Supplier_involvement}
    SafNone -- "critical" --> SuppNone
    SuppNone -- "fix_ready" --> Sched_Final
    SuppNone -- "cooperative" --> Cyber_Final
    SuppNone -- "unresponsive" --> Track_Final

    %% Style des résultats (Couleurs SSVC standard)
    style Imm_Final fill:#f8cecc,stroke:#b85450
    style OOC_Final fill:#fff2cc,stroke:#d6b656
    style Sched_Final fill:#d5e8d4,stroke:#82b366
    style Cyber_Final fill:#dae8fc,stroke:#6c8ebf
    style Track_Final fill:#f5f5f5,stroke:#666666
    style Dismiss_Final fill:#eeeeee,stroke:#333333
    style Defer_Final fill:#e1d5e7,stroke:#9673a6
